# Leave the key empty to reuse local DeepSeek Harness / CC Switch configuration.
# A project key selects independent configuration (official DeepSeek URL by default).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Optional: select an exact model ID from your Harness provider.
DEEPSEEK_MODEL=
# Optional Harness selection; defaults to ~/.dsh, web then desktop, unique DeepSeek provider.
DSH_CONFIG_DIR=
DSH_PROFILE=
DSH_PROVIDER=
PORT=3018
DATA_DIR=./data
